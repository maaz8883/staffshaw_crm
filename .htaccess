# Safety net: the site's document root should be the "public" folder.
# If it points at the project root instead, never list folders or serve project files —
# send every request into public/ (Laravel's front controller).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback when mod_rewrite is unavailable
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
