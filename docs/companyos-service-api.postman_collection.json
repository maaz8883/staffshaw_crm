{
  "info": {
    "name": "Staffshaw CRM – CompanyOS service API",
    "description": "Read-only CRM endpoints for CompanyOS. Set serviceKey to the CRM COMPANYOS_SERVICE_KEY. See docs/companyos-service-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Service-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{serviceKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001/api/v1/service"
    },
    {
      "key": "serviceKey",
      "value": "paste-the-COMPANYOS_SERVICE_KEY-here"
    }
  ],
  "item": [
    {
      "name": "Summary – this month",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "summary"
          ],
          "query": []
        },
        "description": "Company figures for the current month."
      }
    },
    {
      "name": "Summary – custom range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/summary?from=2026-11-01&to=2026-11-30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "summary"
          ],
          "query": [
            {
              "key": "from",
              "value": "2026-11-01"
            },
            {
              "key": "to",
              "value": "2026-11-30"
            }
          ]
        },
        "description": "Figures for a date range (max 366 days)."
      }
    },
    {
      "name": "Sales – approved",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales?from=2026-11-01&to=2026-11-30&approval_status=approved&per_page=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales"
          ],
          "query": [
            {
              "key": "from",
              "value": "2026-11-01"
            },
            {
              "key": "to",
              "value": "2026-11-30"
            },
            {
              "key": "approval_status",
              "value": "approved"
            },
            {
              "key": "per_page",
              "value": "25"
            }
          ]
        },
        "description": "Submitted sales by sale_date."
      }
    },
    {
      "name": "Sales – awaiting approval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales?approval_status=pending_approval",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sales"
          ],
          "query": [
            {
              "key": "approval_status",
              "value": "pending_approval"
            }
          ]
        },
        "description": "Sales still waiting for approval this month."
      }
    },
    {
      "name": "Leads – follow-ups due",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/leads?follow_up_due=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ],
          "query": [
            {
              "key": "follow_up_due",
              "value": "1"
            }
          ]
        },
        "description": "Open leads whose follow-up date is today or past."
      }
    },
    {
      "name": "Leads – new this month",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/leads?from=2026-11-01&to=2026-11-30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ],
          "query": [
            {
              "key": "from",
              "value": "2026-11-01"
            },
            {
              "key": "to",
              "value": "2026-11-30"
            }
          ]
        },
        "description": "Leads created in range."
      }
    },
    {
      "name": "Invoices – unpaid",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/invoices?status=unpaid",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices"
          ],
          "query": [
            {
              "key": "status",
              "value": "unpaid"
            }
          ]
        },
        "description": "Open standalone invoices with amount due."
      }
    },
    {
      "name": "Invoices – overdue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/invoices?status=overdue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices"
          ],
          "query": [
            {
              "key": "status",
              "value": "overdue"
            }
          ]
        },
        "description": "Unpaid invoices past their due date."
      }
    },
    {
      "name": "Expenses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses?from=2026-11-01&to=2026-11-30",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "from",
              "value": "2026-11-01"
            },
            {
              "key": "to",
              "value": "2026-11-30"
            }
          ]
        },
        "description": "Office expenses (PKR)."
      }
    },
    {
      "name": "Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users?per_page=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "100"
            }
          ]
        },
        "description": "CRM users for linking with HRM by email."
      }
    },
    {
      "name": "Events – from start",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/events?after=0&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ],
          "query": [
            {
              "key": "after",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        },
        "description": "New events in id order. Store meta.next_after."
      }
    },
    {
      "name": "Check – no key gives 401",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "summary"
          ],
          "query": []
        },
        "description": "Should return 401 UNAUTHORIZED."
      }
    }
  ]
}
